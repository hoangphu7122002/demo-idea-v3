# Project name: used for Docker Compose project, image names and the API title.
PROJECT_NAME=demo-idea-v3
APP_NAME=demo-idea-v3

# Host ports. Change these if something else on your machine already uses them.
API_PORT=8020
WEB_PORT=5193
APP_PORT=8093
DB_PORT=5472
REDIS_PORT=6419

# Backend connection strings for local dev (keep the ports in sync with DB_PORT / REDIS_PORT).
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5472/app
REDIS_URL=redis://127.0.0.1:6419/0

# AI: "test" uses an offline fake model. For a real model set e.g.
# LLM_MODEL=anthropic:claude-sonnet-5-5 and ANTHROPIC_API_KEY=...
LLM_MODEL=test
PYDANTIC_AI_NO_BANNER=1
